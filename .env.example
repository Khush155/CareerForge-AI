# ==========================================
# CareerForge AI - Environment Configuration
# ==========================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Mode: mock | azure
# Keep as 'mock' for local development without consuming Azure credits
MODE=mock

# Azure OpenAI / Foundry Configuration (Fill when ready for Phase 2/3)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Embeddings (Optional: text-embedding-3-small)
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# SQLite Storage Path
DATABASE_PATH=data/careerforge.db
